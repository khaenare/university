          },
          "expr": "sum(rate(pg_stat_database_blks_hit{datname=\"shop\"}[5m])) / (sum(rate(pg_stat_database_blks_hit{datname=\"shop\"}[5m])) + sum(rate(pg_stat_database_blks_read{datname=\"shop\"}[5m])))",
