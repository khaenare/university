# Скопіюйте цей файл у .env і заповніть усі паролі:
#   cp .env.example .env
# Порожній пароль не дасть запустити систему. Згенерувати пароль можна так:
#   openssl rand -base64 18
# Файл .env не потрапляє в git (див. .gitignore).

# Суперкористувач PostgreSQL. Увага: паролі PostgreSQL (тут і нижче) застосовуються
# лише при першому створенні тому pg-data; пізніше їх змінюють командою ALTER ROLE.
POSTGRES_USER=shop
POSTGRES_PASSWORD=

# Пароль ролі shop_app (генератор навантаження: лише робота з даними магазину)
APP_DB_PASSWORD=

# Пароль ролі exporter (postgres-exporter: лише читання статистики)
EXPORTER_PASSWORD=

# Перший користувач сервера авторизації (створюється, лише якщо користувачів ще немає).
# Логін — латиниця, цифри, . _ -; пароль — щонайменше 8 символів.
# Пізніше пароль змінюють командою:
#   docker compose exec auth python app.py add-user admin <новий_пароль>
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Пароль вбудованого адміністратора Grafana (увійти з ним неможливо,
# вхід лише через шлюз, але стандартний admin/admin не залишаємо)
GRAFANA_ADMIN_PASSWORD=
